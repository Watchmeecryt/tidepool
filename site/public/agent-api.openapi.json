    "/v1/agents/{agent_id}/withdraw": {
      "post": {
        "summary": "Withdraw to NEAR or a bridged chain",
        "description": "chain near: NEAR-native tokens to a NEAR account. Otherwise chain is the token blockchain (base, arb, eth, sol, stellar, sui, xrp, btc, zec: exactly the testnets /v0 pays out on, as listed by GET /v1/tokens) and recipient an address on that chain. Same per-payout caps as /v0. No memo off NEAR. dry:true supported.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-grant-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^ngt_[A-Za-z0-9_-]{43}$"
            },
            "description": "Grant token. Its sha256 hex was registered as the credential by a signed grant_issue intent."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Unique per action. Same key + same body replays the original execution; same key + different body returns 409 idempotency_conflict."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "asset",
                  "amount",
                  "chain",
                  "recipient"
                ],
                "properties": {
                  "asset": {
                    "type": "string",
                    "description": "Asset id from GET /v1/tokens, e.g. nep141:usdc.tidepool-sandbox.testnet"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Atomic (base-unit) integer string"
                  },
                  "chain": {
                    "enum": [
                      "near",
                      "base",
                      "arb",
                      "eth",
                      "sol",
                      "stellar",
                      "sui",
                      "xrp",
                      "btc",
                      "zec"
                    ]
                  },
                  "recipient": {
                    "type": "string"
                  },
                  "dry": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dry run result (dry: true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted. Poll GET /v1/status?correlation_id=...",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agent_id}/deposit": {
      "post": {
        "summary": "Fund the agent wallet",
        "description": "testnet_faucet:true drips test tokens into the agent wallet. Otherwise returns a deposit address and waits (PENDING_DEPOSIT) until the balance rises. No grant token is needed; an Idempotency-Key is still required. The faucet allows one drip per agent wallet per hour (and a few per IP per hour): when it is rate-limited the request answers 429 rate_limited synchronously (with Retry-After) and no execution is created. A 202 means the drip was accepted; still poll GET /v1/status until SUCCESS before relying on the balance (it can end FAILED if the testnet call fails).",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-grant-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^ngt_[A-Za-z0-9_-]{43}$"
            },
            "description": "Optional for deposits (no grant is needed, like the official API). If sent it must be a valid grant for this agent."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Unique per action. Same key + same body replays the original execution; same key + different body returns 409 idempotency_conflict."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "origin_asset"
                ],
                "properties": {
                  "origin_asset": {
                    "type": "string",
                    "description": "Asset id from GET /v1/tokens, e.g. nep141:usdc.tidepool-sandbox.testnet"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Atomic (base-unit) integer string"
                  },
                  "testnet_faucet": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dry run result (dry: true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted. Poll GET /v1/status?correlation_id=...",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: the testnet faucet was used for this wallet within the last hour, or this IP hit its hourly faucet limit. Retry-After gives the wait in seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        }
      }
    },
    "/v1/releases": {
      "get": {
        "summary": "List releases",
        "tags": [
          "Releases"
        ],
        "responses": {
          "200": {
            "description": "Release",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/releases/latest": {
      "get": {
        "summary": "Latest release (SDK getLatestRelease)",
        "tags": [
          "Releases"
        ],
        "responses": {
          "200": {
            "description": "Release",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
