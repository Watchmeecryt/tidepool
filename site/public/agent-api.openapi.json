              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "naa_ key"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "KeyIssued": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "pattern": "^naa_[A-Za-z0-9_-]{43}$"
          },
          "api_key_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "limits": {
            "type": "object"
          },
          "usage": {
            "type": "object"
          }
        }
      },
      "Execution": {
        "type": "object",
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_SIGNATURE",
              "QUEUED",
              "PROCESSING",
              "PENDING_DEPOSIT",
              "SUCCESS",
              "FAILED",
              "REFUNDED",
              "UNCERTAIN",
              "NEEDS_REVIEW"
            ]
          },
          "failure_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "description": "tx_hash, amount_out, agent_id, grant, ..."
          }
        }
      },
      "Policy": {
        "type": "object",
        "description": "Enforced off-chain by the API; changes apply immediately. confidential, owner_approval, timelock and schedule are rejected.",
        "properties": {
          "frozen": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "swap",
                "transfer",
                "withdraw",
                "deposit"
              ]
            }
          },
          "assets": {
            "oneOf": [
              {
                "const": "any"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "limits": {
            "type": "object",
            "description": "per_transaction | hourly | daily | monthly -> { asset_id: atomic amount }"
          },
          "max_actions_per_hour": {
            "type": [
              "integer",
              "null"
            ]
          },
          "destinations": {
            "type": "object",
            "required": [
              "mode",
              "list"
            ],
            "description": "mode \"only\" allows just the listed destinations, \"except\" blocks them, \"any\" ignores the list. (\"allowlist\"/\"denylist\" are not accepted: 400 validation_failed.)",
            "properties": {
              "mode": {
                "enum": [
                  "any",
                  "only",
                  "except"
                ]
              },
              "list": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "action",
                        "address"
                      ],
                      "properties": {
                        "action": {
                          "const": "transfer"
                        },
                        "address": {
                          "type": "string",
                          "description": "NEAR testnet account id"
                        },
                        "confidential": {
                          "type": "boolean",
                          "default": false
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "action",
                        "chain",
                        "address"
                      ],
                      "properties": {
                        "action": {
                          "const": "withdraw"
                        },
                        "chain": {
                          "type": "string",
                          "description": "near, base, arb, eth, sol, stellar, sui, xrp, btc, zec"
                        },
                        "address": {
                          "type": "string"
                        },
                        "memo": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "example": {
              "mode": "only",
              "list": [
                {
                  "action": "transfer",
                  "address": "shop.testnet",
                  "confidential": false
                }
              ]
            }
          },
          "budget": {
            "type": "object",
            "description": "USD budget keys (decimal strings, null = off); see the guide"
          }
        }
      },
      "ErrorDocument": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "layer": {
                  "enum": [
                    "request",
                    "policy",
                    "wallet",
                    "api",
                    "execution"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "pointer": {
                      "type": "string"
                    }
                  }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "retryable": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
