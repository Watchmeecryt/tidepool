    "/v1/generate-intent": {
      "post": {
        "summary": "Build an owner intent to sign",
        "description": "Types: agent_create, grant_issue, grant_revoke, policy_update, agent_freeze, agent_unfreeze. Returns a nep413 payload (message, nonce, recipient) and a correlation_id. Sign with the owner ed25519 key, then POST /v1/submit-intent.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Unique per action. Same key + same body replays the original execution; same key + different body returns 409 idempotency_conflict."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "agent_create",
                      "grant_issue",
                      "grant_revoke",
                      "policy_update",
                      "agent_freeze",
                      "agent_unfreeze"
                    ]
                  },
                  "agent_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "near"
                        ]
                      },
                      "account_id": {
                        "type": "string"
                      },
                      "public_key": {
                        "type": "string",
                        "description": "ed25519:<base58>"
                      }
                    }
                  },
                  "policy": {
                    "$ref": "#/components/schemas/Policy"
                  },
                  "expected_revision": {
                    "type": "integer"
                  },
                  "credential": {
                    "type": "string",
                    "description": "sha256 hex of the grant token string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "grant_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Intent to sign",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        }
      }
    },
    "/v1/submit-intent": {
      "post": {
        "summary": "Submit a signed owner intent",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "correlation_id",
                  "signed_data"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "correlation_id": {
                    "type": "string"
                  },
                  "signed_data": {
                    "type": "object",
                    "required": [
                      "standard",
                      "payload",
                      "public_key",
                      "signature"
                    ],
                    "properties": {
                      "standard": {
                        "enum": [
                          "nep413"
                        ]
                      },
                      "payload": {
                        "type": "object",
                        "description": "The payload returned by generate-intent, unchanged"
                      },
                      "public_key": {
                        "type": "string"
                      },
                      "signature": {
                        "type": "string",
                        "description": "base64 ed25519 signature of the NEP-413 hash"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Status of an intent or action",
