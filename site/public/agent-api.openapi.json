      "get": {
        "summary": "Index",
        "description": "Service index with the self-serve key URL. No auth.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
