    "/v1/agents/{agent_id}/swap": {
      "post": {
        "summary": "Swap (or dry-run quote)",
        "description": "dry:true needs only the API key and never refuses for policy or balance reasons: it returns warnings[]. A real swap needs x-grant-token and Idempotency-Key and is checked against the policy.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-grant-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^ngt_[A-Za-z0-9_-]{43}$"
            },
            "description": "Grant token. Its sha256 hex was registered as the credential by a signed grant_issue intent."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Unique per action. Same key + same body replays the original execution; same key + different body returns 409 idempotency_conflict."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "origin_asset",
                  "destination_asset",
                  "amount"
                ],
                "properties": {
                  "origin_asset": {
                    "type": "string",
                    "description": "Asset id from GET /v1/tokens, e.g. nep141:usdc.tidepool-sandbox.testnet"
                  },
                  "destination_asset": {
                    "type": "string",
                    "description": "Asset id from GET /v1/tokens, e.g. nep141:usdc.tidepool-sandbox.testnet"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Atomic (base-unit) integer string"
                  },
                  "dry": {
                    "type": "boolean"
                  },
                  "slippage_bps": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dry run result (dry: true)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted. Poll GET /v1/status?correlation_id=...",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Execution"
                }
              }
            }
          },
          "4XX": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        }
      }
    },
