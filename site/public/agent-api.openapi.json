          },
          "404": {
            "description": "JSON:API error document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDocument"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "correlation_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wait_ms",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 30000
            }
          }
        ]
      }
    },
